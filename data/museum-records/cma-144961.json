    },
    {
      "inscription": "Om Ah Hum",
      "inscription_translation": null,
      "inscription_remark": "Behind brow, throat, and heart of Green Tara",
      "sortorder": null
    },
    {
      "inscription": "om tare tutare ture svaha",
