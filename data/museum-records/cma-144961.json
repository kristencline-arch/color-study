      "sortorder": null
    },
    {
      "inscription": "Om Ah Hum",
      "inscription_translation": null,
      "inscription_remark": "Behind the figure of the monastic donor",
      "sortorder": null
    },
    {
      "inscription": "om ah sarva vyida svaha",
      "inscription_translation": null,
      "inscription_remark": "Sanskrit mantra, top line of the inscriptions on the verso",
      "sortorder": null
    },
    {
      "inscription": "ye dharmā hetuprabhavā he-\ntuṃ teṣāṃ tathāgato hy avadat teṣāṃ ca yo \nnirodha evaṃvādī mahāśramaṇaḥ",
      "inscription_translation": "Of those phenomena which arise from causes:\nThose causes have been taught by the Tathāgata (Buddha),\nAnd their cessation too - thus proclaims the Great Ascetic.",
